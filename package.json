    "@types/react-google-recaptcha": "^2.1.9",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.6",
    "firebase": "^10.12.2",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.396.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.52.0",
