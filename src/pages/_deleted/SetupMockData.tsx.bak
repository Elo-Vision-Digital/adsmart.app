import { useState } from 'react'
import { doc, setDoc, collection, addDoc, serverTimestamp } from 'firebase/firestore'
import { db } from '@/firebase/config'
import { Button } from '@/components/ui/button'
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card'
import { Input } from '@/components/ui/input'
import { MainLayout } from '@/components/layout/MainLayout'
import { Loader2, CheckCircle } from 'lucide-react'

export function SetupMockData() {
  const [loading, setLoading] = useState(false)
  const [userUid, setUserUid] = useState('')
  const [status, setStatus] = useState<string[]>([])
  const [success, setSuccess] = useState(false)

  const addStatus = (message: string) => {
    setStatus(prev => [...prev, `✅ ${message}`])
  }

  const setupMockData = async () => {
    if (!userUid.trim()) {
      alert('Por favor, insira o UID do usuário')
      return
    }

    setLoading(true)
    setStatus([])
    setSuccess(false)

    try {
      // 1. Criar/atualizar perfil no Firestore
      await setDoc(doc(db, 'users', userUid), {
        email: 'review.user@adsmart.app',
        displayName: 'Meta Review User',
        role: 'reviewer',
        createdAt: serverTimestamp(),
        isTestUser: true
      }, { merge: true })
      addStatus('Perfil criado/atualizado no Firestore')

      // 2. Criar carteira com créditos
      await setDoc(doc(db, 'wallets', userUid), {
        userId: userUid,
        balance: 50000, // R$ 500,00 em centavos
        currency: 'BRL',
        updatedAt: serverTimestamp()
      }, { merge: true })
      addStatus('Carteira criada com R$ 500,00')

      // 3. Adicionar transação de crédito
      await addDoc(collection(db, 'transactions'), {
        userId: userUid,
        type: 'credit',
        amount: 50000,
        description: 'Crédito inicial para teste de revisão Meta',
        status: 'completed',
        createdAt: serverTimestamp()
      })
      addStatus('Transação de crédito registrada')

      // 4. Criar contas de anúncios mock
      const mockAccounts = [
        {
          platform: 'meta_ads',
          accountId: 'act_123456789',
          accountName: 'Test Business Account',
          email: 'review.user@adsmart.app',
          currency: 'USD',
          timezone: 'America/New_York',
          isActive: true,
          createdAt: serverTimestamp(),
          updatedAt: serverTimestamp(),
          lastSyncAt: serverTimestamp()
        },
        {
          platform: 'google_ads',
          accountId: '123-456-7890',
          accountName: 'Test Google Ads Account',
          email: 'review.user@adsmart.app',
          isActive: true,
          createdAt: serverTimestamp(),
          updatedAt: serverTimestamp(),
          lastSyncAt: serverTimestamp()
        }
      ]

      for (const account of mockAccounts) {
        await setDoc(
          doc(db, 'users', userUid, 'adAccounts', `${account.platform}_${account.accountId}`),
          account
        )
      }
      addStatus('Contas de anúncios mock criadas')

      // 5. Criar campanhas mock
      const mockCampaigns = [
        {
          accountId: 'act_123456789',
          platform: 'meta_ads',
          campaignId: 'camp_001',
          campaignName: 'Summer Sale Campaign',
          status: 'active',
          objective: 'CONVERSIONS',
          budget: 10000,
          spend: 7500,
          impressions: 125000,
          clicks: 3200,
          lastSyncAt: serverTimestamp()
        },
        {
          accountId: 'act_123456789',
          platform: 'meta_ads',
          campaignId: 'camp_002',
          campaignName: 'Brand Awareness Campaign',
          status: 'paused',
          objective: 'BRAND_AWARENESS',
          budget: 5000,
          spend: 2500,
          impressions: 85000,
          clicks: 1200,
          lastSyncAt: serverTimestamp()
        },
        {
          accountId: 'act_123456789',
          platform: 'meta_ads',
          campaignId: 'camp_003',
          campaignName: 'Holiday Promotion',
          status: 'active',
          objective: 'TRAFFIC',
          budget: 20000,
          spend: 18500,
          impressions: 450000,
          clicks: 8900,
          lastSyncAt: serverTimestamp()
        }
      ]

      for (const campaign of mockCampaigns) {
        await setDoc(
          doc(db, 'users', userUid, 'campaigns', `${campaign.platform}_${campaign.campaignId}`),
          campaign
        )
      }
      addStatus('Campanhas mock criadas')

      // 6. Criar páginas mock
      const mockPages = [
        {
          pageId: 'page_001',
          pageName: 'Adsmart Official Page',
          followers: 15420,
          likes: 14890,
          engagement: {
            posts: 125,
            comments: 3420,
            shares: 890,
            reactions: 12500
          },
          lastSyncAt: serverTimestamp()
        },
        {
          pageId: 'page_002',
          pageName: 'Adsmart Support',
          followers: 8930,
          likes: 8520,
          engagement: {
            posts: 89,
            comments: 1250,
            shares: 340,
            reactions: 5600
          },
          lastSyncAt: serverTimestamp()
        }
      ]

      for (const page of mockPages) {
        await setDoc(
          doc(db, 'users', userUid, 'pages', page.pageId),
          page
        )
      }
      addStatus('Páginas Facebook mock criadas')

      // 7. Criar relatório de exemplo
      await addDoc(collection(db, 'reports'), {
        userId: userUid,
        type: 'meta_ads',
        templateId: 'meta_lancamento',
        name: 'Q4 2024 Performance Report',
        status: 'completed',
        campaignIds: ['camp_001', 'camp_003'],
        allCampaigns: false,
        dateRange: {
          startDate: '2024-10-01',
          endDate: '2024-12-31'
        },
        lookerStudioUrl: 'https://lookerstudio.google.com/reporting/sample-report-1',
        cost: 500,
        paidAt: serverTimestamp(),
        createdAt: serverTimestamp(),
        completedAt: serverTimestamp()
      })
      addStatus('Relatório de exemplo criado')

      setSuccess(true)
      addStatus('🎉 Dados mock configurados com sucesso!')

    } catch (error: any) {
      console.error('Erro:', error)
      alert(`Erro: ${error.message}`)
    } finally {
      setLoading(false)
    }
  }

  return (
    <MainLayout>
      <div className="min-h-screen bg-background p-6">
        <div className="max-w-4xl mx-auto space-y-6">
          <Card>
            <CardHeader>
              <CardTitle>Configurar Dados Mock para Usuário de Teste</CardTitle>
              <CardDescription>
                Use esta página após criar o usuário no Firebase Console
              </CardDescription>
            </CardHeader>
            <CardContent className="space-y-4">
              <div className="space-y-2">
                <label className="text-sm font-medium">
                  UID do usuário (obtido no Firebase Console)
                </label>
                <Input
                  placeholder="Ex: AbCdEfGhIjKlMnOpQrStUvWxYz"
                  value={userUid}
                  onChange={(e) => setUserUid(e.target.value)}
                />
                <p className="text-xs text-gray-500">
                  Firebase Console → Authentication → Users → Clique no usuário → Copie o UID
                </p>
              </div>

              <Button 
                onClick={setupMockData}
                disabled={loading || !userUid.trim()}
                className="w-full"
                size="lg"
              >
                {loading ? (
                  <>
                    <Loader2 className="mr-2 h-4 w-4 animate-spin" />
                    Configurando dados mock...
                  </>
                ) : (
                  'Configurar Dados Mock'
                )}
              </Button>

              {status.length > 0 && (
                <Card className="bg-gray-50 dark:bg-gray-900">
                  <CardContent className="pt-6">
                    <div className="space-y-1 font-mono text-sm">
                      {status.map((msg, idx) => (
                        <div key={idx}>{msg}</div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              )}

              {success && (
                <Card className="border-green-500 bg-green-50 dark:bg-green-900/20">
                  <CardContent className="pt-6">
                    <div className="flex items-start gap-3">
                      <CheckCircle className="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" />
                      <div className="space-y-4">
                        <p className="font-medium text-green-900 dark:text-green-100">
                          Dados mock configurados!
                        </p>
                        <div className="space-y-2 text-sm">
                          <p className="font-medium">Credenciais do usuário:</p>
                          <div className="bg-white dark:bg-gray-800 p-3 rounded-md space-y-1 font-mono">
                            <p>Email: review.user@adsmart.app</p>
                            <p>Senha: Test!Review2025</p>
                            <p>UID: {userUid}</p>
                          </div>
                        </div>
                        <div className="space-y-2 text-sm">
                          <p className="font-medium">URLs para teste:</p>
                          <div className="bg-white dark:bg-gray-800 p-3 rounded-md space-y-1">
                            <p>Login: https://adsmart-web.web.app/login</p>
                            <p>Demo: https://adsmart-web.web.app/meta-review-demo</p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </CardContent>
                </Card>
              )}
            </CardContent>
          </Card>

          <Card className="bg-yellow-50 dark:bg-yellow-900/20">
            <CardHeader>
              <CardTitle className="text-lg">📝 Instruções</CardTitle>
            </CardHeader>
            <CardContent className="space-y-3 text-sm">
              <p><strong>1.</strong> Acesse o Firebase Console</p>
              <p><strong>2.</strong> Vá para Authentication → Users</p>
              <p><strong>3.</strong> Clique em "Add user" e crie:</p>
              <div className="ml-4 bg-white dark:bg-gray-800 p-2 rounded font-mono text-xs">
                <p>Email: review.user@adsmart.app</p>
                <p>Password: Test!Review2025</p>
              </div>
              <p><strong>4.</strong> Após criar, clique no usuário e copie o UID</p>
              <p><strong>5.</strong> Cole o UID no campo acima e clique em "Configurar Dados Mock"</p>
            </CardContent>
          </Card>
        </div>
      </div>
    </MainLayout>
  )
}