// Arquivo temporário para verificar as traduções
import { useLanguage } from './contexts/LanguageContext'

export function testTranslations() {
  const { t, language, setLanguage } = useLanguage()
  
  // Testar algumas chaves de tradução
  console.log('Hero title:', t('hero.title'))
  console.log('Current language:', language)
  console.log('Features title:', t('features.title'))
  console.log('Testimonial 1:', t('testimonials.1.content'))
  console.log('FAQ 1:', t('faq.1.question'))
  
  // Mudar idioma
  setLanguage('en')
  console.log('Changed to English')
  
  return true
}
