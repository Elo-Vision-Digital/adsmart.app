# Firebase Functions URL (production)
VITE_FIREBASE_FUNCTIONS_URL=https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net

# Development Mode
VITE_USE_EMULATORS=false

# reCAPTCHA Site Key (visible no frontend)
VITE_RECAPTCHA_SITE_KEY=

