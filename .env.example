# EXEMPLO DE VARIÁVEIS DE AMBIENTE - FUNCTIONS

# Este arquivo é apenas um exemplo. Para configurar:
# 1. Use o comando: firebase functions:config:set
# 2. Ou execute: ./scripts/setup-oauth.sh

# Criptografia
ENCRYPTION_KEY=sua_chave_hex_32_bytes

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FUNCTIONS_REGION=

# Firebase Functions URL
VITE_FIREBASE_FUNCTIONS_URL=

# Firebase Hosting URL
VITE_FIREBASE_HOSTING_URL=

# ReCAPTCHA
VITE_RECAPTCHA_SITE_KEY=

# Google Ads OAuth
# firebase functions:config:set google_ads.client_id="seu_google_client_id"
# firebase functions:config:set google_ads.client_secret="seu_google_client_secret"
# firebase functions:config:set google_ads.developer_token="seu_developer_token"
# firebase functions:config:set google_ads.redirect_uri="https://your-domain.app/auth/google-ads/callback"

# Meta Ads OAuth  
# firebase functions:config:set meta_ads.app_id="seu_facebook_app_id"
# firebase functions:config:set meta_ads.app_secret="seu_facebook_app_secret"
# firebase functions:config:set meta_ads.redirect_uri="https://your-domain.app/auth/meta-ads/callback"

# Para desenvolvimento local
# cd functions && firebase functions:config:get > .runtimeconfig.json

# Looker Studio Templates IDs
VITE_LOOKER_GOOGLE_LAUNCH_ID=
VITE_LOOKER_META_LAUNCH_ID=
VITE_LOOKER_GOOGLE_LOCAL_ID=
VITE_LOOKER_META_LOCAL_ID=

# SuitPay Configuration (Produção)
VITE_SUITPAY_CLIENT_ID=
VITE_SUITPAY_CLIENT_SECRET=
VITE_SUITPAY_WEBHOOK_URL=

