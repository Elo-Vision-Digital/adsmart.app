      "mcp__plugin_firebase_firebase__firebase_login",
      "mcp__plugin_firebase_firebase__firebase_logout",
      "mcp__plugin_firebase_firebase__firebase_read_resources",
      "mcp__plugin_firebase_firebase__firebase_update_environment",
      "mcp__plugin_firebase_firebase__firebase_validate_security_rules",
      "mcp__plugin_firebase_firebase__firestore_add_document",
      "mcp__plugin_firebase_firebase__firestore_create_database",
      "mcp__plugin_firebase_firebase__firestore_create_index",
      "mcp__plugin_firebase_firebase__firestore_delete_database",
      "mcp__plugin_firebase_firebase__firestore_delete_document",
      "mcp__plugin_firebase_firebase__firestore_delete_index",
      "mcp__plugin_firebase_firebase__firestore_get_database",
      "mcp__plugin_firebase_firebase__firestore_get_document",
      "mcp__plugin_firebase_firebase__firestore_get_index",
      "mcp__plugin_firebase_firebase__firestore_list_collections",
      "mcp__plugin_firebase_firebase__firestore_list_databases",
      "mcp__plugin_firebase_firebase__firestore_list_documents",
      "mcp__plugin_firebase_firebase__firestore_list_indexes",
      "mcp__plugin_firebase_firebase__firestore_query_collection",
      "mcp__plugin_firebase_firebase__firestore_update_database",
      "mcp__plugin_firebase_firebase__firestore_update_document",
      "mcp__plugin_firebase_firebase__functions_get_logs",
      "mcp__plugin_firebase_firebase__functions_list_functions",
      "mcp__plugin_firebase_firebase__messaging_send_message",
      "mcp__plugin_firebase_firebase__realtimedatabase_get_data",
      "mcp__plugin_firebase_firebase__realtimedatabase_set_data",
      "mcp__plugin_firebase_firebase__remoteconfig_get_template",
      "mcp__plugin_firebase_firebase__remoteconfig_update_template",
      "mcp__plugin_firebase_firebase__storage_get_object_download_url"
    ]
  },
  "enabledPlugins": {
    "firebase@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "stripe@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(functions/src/**/*.ts)|Write(functions/src/**/*.ts)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/firebase/check-no-process-env-secret.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(src/**/*.ts)|Write(src/**/*.ts)|Edit(src/**/*.tsx)|Write(src/**/*.tsx)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/firebase/check-no-client-wallet-write.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*firestore:rules*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/firebase/check-rules-tested.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/.env.example)|Write(**/.env.example)|Edit(**/.env.*.example)|Write(**/.env.*.example)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/firebase/check-no-secret-in-env-example.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(src/**/*.tsx)|Write(src/**/*.tsx)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/check-no-hardcoded-literal.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(packages/shared/src/schemas/**/*.ts)|Write(packages/shared/src/schemas/**/*.ts)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/check-zod-schema-test.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(functions/src/**/*.ts)|Write(functions/src/**/*.ts)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/check-llm-call-via-logger.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(firestore.rules)|Write(firestore.rules)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/check-firestore-rule-defaults-deny.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(docs/specs/**)|Write(docs/specs/**)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/check-contract-exists.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git commit*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/check-progress-updated.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*gh pr create*)|Bash(*git push*origin*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/check-sensors-passed.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/EVALUATION.md)|Write(**/EVALUATION.md)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/check-implementer-not-validator.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(firestore.rules)|Write(firestore.rules)",
            "command": "echo 'firestore.rules editada. Próximos passos: /firestore-rules-test → firestore-rules-reviewer agent → /firebase-deploy.'"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(packages/shared/src/schemas/**)|Write(packages/shared/src/schemas/**)",
            "command": "echo 'Schema editado. CLAUDE.md exige: teste co-located + DATA-MODEL.md + entry em CHANGES.md. ADR-009.'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/firebase/inject-firebase-context.sh"
          }
        ]
      }
    ]
  }
}
