# SuitPay - Obtenha no painel: https://web.suitpay.app
# Formato esperado:
# - CLIENT_ID: algo como "adsmart_1234567890"
# - CLIENT_SECRET: string de 64 caracteres hexadecimais
SUITPAY_CLIENT_ID=SEU_CLIENT_ID_AQUI
SUITPAY_CLIENT_SECRET=SEU_CLIENT_SECRET_AQUI

# Google Ads (Secret - use Firebase Secrets em produção)
# GOOGLE_ADS_CLIENT_SECRET=seu_secret_aqui

# Meta Ads (Secret - use Firebase Secrets em produção)
