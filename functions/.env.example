# Cloud Functions environment template.
#
# Copy this to functions/.env (gitignored) and fill with project-specific
# values. The Firebase CLI loads .env at deploy time and resolves
# defineString/defineSecret params from it.
#
# Rules:
# - Secrets (anything sensitive) MUST be in Cloud Secret Manager via
#   `firebase functions:secrets:set NAME`. Do NOT put real secret values
#   in .env — defineSecret reads from Secret Manager, not from .env.
# - Non-secret params (IDs, public URLs) live in .env per project.
# - This .env.example contains only placeholder strings. Real values
#   come from your provider consoles (Google Cloud Console, Meta App
#   Dashboard).

# Google Ads (non-secret, public OAuth client id + redirect URIs)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_REDIRECT_URI=
GOOGLE_ADS_REDIRECT_URI_DEV=

# Meta Ads (non-secret, public app id + redirect URIs)
META_ADS_APP_ID=
META_ADS_REDIRECT_URI=
META_ADS_REDIRECT_URI_DEV=

# Secrets provisioned via `firebase functions:secrets:set` — do NOT
# duplicate them here. Names declared via defineSecret() in
# functions/src/config/index.ts:
#   GOOGLE_ADS_CLIENT_SECRET
#   GOOGLE_ADS_DEVELOPER_TOKEN
#   META_ADS_APP_SECRET
#   ENCRYPTION_KEY
